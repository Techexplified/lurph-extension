{
  "manifest_version": 3,
  "name": "Lurph AI",
  "version": "1.1.0",
  "description": "Your AI assistant for the web.",
  "permissions": [
    "identity",
    "storage",
    "sidePanel",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://lurph-extension-backend.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Lurph AI",
    "default_icon": {
      "16": "icons/lurph-16.png",
      "24": "icons/lurph-24.png",
      "32": "icons/lurph-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/lurph-16.png",
    "32": "icons/lurph-32.png",
    "48": "icons/lurph-48.png",
    "128": "icons/lurph-128.png"
  }
}
